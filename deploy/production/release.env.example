# Copy this file to release.env on the server and set mode 600.
# Do not commit release.env.

RELEASE_ID=20260714-upstream-upgrade
APP_DIR=/opt/new-api
COMPOSE_FILE=/opt/new-api/docker-compose.yml
APP_SERVICE=new-api
APP_CONTAINER=new-api

# Source archive is unpacked here before build-image.sh runs.
SOURCE_DIR=/opt/new-api/releases/20260714-upstream-upgrade/source
NEW_IMAGE=new-api-custom:20260714-upstream-upgrade
PLATFORM=linux/amd64
SOURCE_COMMIT=

BACKUP_ROOT=/opt/new-api/backups
MEDIA_DIR=/opt/new-api/media
LOG_DIR=/opt/new-api/logs
DATA_DIR=/opt/new-api/data

HEALTHCHECK_URL=http://127.0.0.1:3000/api/status
PUBLIC_STATUS_URL=https://example.com/api/status

# postgres, mysql, or sqlite
DB_TYPE=postgres
DB_SERVICE=postgres
DB_NAME=new-api
DB_USER=root
# MySQL client password, only required when socket authentication is unavailable.
DB_PASSWORD=
# Only used for SQLite. Stop writes before taking the backup.
SQLITE_FILE=/opt/new-api/data/one-api.db

# Optional files or directories, separated by spaces. Paths containing spaces
# are not supported here. Add reverse proxy and certificate config locations.
EXTRA_BACKUP_PATHS=/opt/new-api/nginx

# Keep this true unless the old image is already stored in a private registry.
SAVE_OLD_IMAGE=true

# Stop only the application container while database/media/data snapshots are
# created. This gives a consistent backup and the script starts it again before exit.
STOP_APP_FOR_BACKUP=true
